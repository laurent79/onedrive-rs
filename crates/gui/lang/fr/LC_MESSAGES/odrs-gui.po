msgid "Files (patterns separated by |, e.g. *.bak|*.iso)"
msgstr "Fichiers (motifs séparés par |, par exemple *.bak|*.iso)"

msgid "Always ignored as well: ~*, .~*, *.tmp, *.swp, *.partial"
msgstr "Toujours ignorés en plus : ~*, .~*, *.tmp, *.swp, *.partial"

msgid "Folders (a name anywhere, or a path such as Documents/Old)"
msgstr "Dossiers (un nom, où qu'il soit, ou un chemin comme Documents/Ancien)"

msgid "Hidden files and folders (names starting with a dot)"
msgstr "Fichiers et dossiers cachés (noms commençant par un point)"

msgid "Items no longer synchronised keep their local copy; newly included ones are downloaded."
msgstr "Les éléments qui ne sont plus synchronisés gardent leur copie locale ; ceux qui le redeviennent sont téléchargés."

