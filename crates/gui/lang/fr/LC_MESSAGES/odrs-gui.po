msgid "The Microsoft session has expired: synchronisation is stopped until you sign in again."
msgstr "La session Microsoft a expiré : la synchronisation est arrêtée jusqu'à la prochaine connexion."

msgid "{}: your local version was kept as {}."
msgstr "{} : votre version locale a été conservée sous le nom {}."

msgid "{n} local version was kept as a “-safeBackup-” copy."
