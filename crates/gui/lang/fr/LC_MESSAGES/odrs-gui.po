msgstr[0] "{n} version locale a été conservée en copie « -safeBackup- »."
msgstr[1] "{n} versions locales ont été conservées en copies « -safeBackup- »."

msgid "The first synchronisation is complete."
msgstr "La première synchronisation est terminée."

msgid "All files are intact."
msgstr "Tous les fichiers sont intacts."

