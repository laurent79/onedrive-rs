import { Button, CheckBox, LineEdit, SpinBox, ListView, ProgressIndicator, Spinner, StandardListView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

// Daemon-wide state, pushed from Rust once per second.
export struct Status {
    // "idle" | "syncing" | "paused" | "error" | "stopped" (daemon not running)
    state: string,
    account: string,
    // Folder of the account's own OneDrive.
    sync-dir: string,
    last-error: string,
    // The stored login expired: offer to sign in again.
    needs-login: bool,
}

// One synchronised drive (the account's OneDrive or a SharePoint library).
export struct DriveRow {
    // Identifier for commands: "main" or the [drive] name.
    name: string,
    // Shown to the user.
    title: string,
    sync-dir: string,
    // "idle" | "syncing" | "error" | "pending"
    state: string,
    last-error: string,
    // Minutes since its last successful pass, -1 if never.
    last-sync-mins: int,
    items: int,
    downloaded: int,
    uploaded: int,
    removable: bool,
    // Overall progress while syncing a drive that is not complete yet.
    show-progress: bool,
    // 0..1
    fraction: float,
    synced-gb: float,
    total-gb: float,
    // Download rate over the last seconds, -1 if unknown.
    rate-mbs: float,
    // Estimated minutes left, -1 if unknown.
    eta-mins: int,
    // Uploads of the current pass, while some are large enough to be worth a bar.
    show-upload: bool,
    // 0..1
    upload-fraction: float,
    // Files finished, files started.
    upload-done: int,
    upload-files: int,
    upload-sent-mb: float,
    upload-total-mb: float,
    // Upload rate over the last seconds, -1 if unknown.
    upload-rate-mbs: float,
    // Integrity check: "" (never) | "queued" | "running" | "done" | "cancelled" | "failed"
    verify-state: string,
    verify-done: int,
    verify-total: int,
    // 0..1
    verify-fraction: float,
    // Files missing, modified or unreadable.
    verify-problems: int,
    // Minutes since it ended, -1 if unknown.
    verify-mins: int,
    verify-message: string,
    // safeBackup copies still present, items its last pass could not sync.
    conflicts: int,
    failures: int,
}

// One line of the "to resolve" window of a drive.
export struct ProblemRow {
    // "conflict" | "error"
    kind: string,
    // File name.
    name: string,
    // Conflict: name of the copy of the local version. Error: the message.
    detail: string,
    // Absolute path of the file (an online name if it has no local place).
    path: string,
    // Conflict: absolute path of the copy of the local version.
    backup: string,
}

// One line of the folder chooser (a folder of the drive, at some depth).
export struct FolderRow {
    path: string,
    name: string,
    depth: int,
    // 0: not synced, 1: synced, 2: partly (some subfolders differ).
    check: int,
    expanded: bool,
    has-children: bool,
    // Its subfolders are being listed.
    loading: bool,
}

// One line of the recent activity, newest first.
export struct ActivityRow {
    // "downloaded" | "uploaded" | "deleted" | "deleted-online" | "conflict" | "initial-sync" | "more"
    kind: string,
    // File name (empty for a drive-wide event).
    name: string,
    // Drive title.
    drive: string,
    // Minutes since it happened.
    mins: int,
    // Absolute local path, empty if none.
    path: string,
    // Name of the safeBackup copy of a conflict.
    backup: string,
    // Files not listed ("more").
    count: int,
}

export global Logic {
    callback sync-now();
    callback toggle-pause();
    callback open-folder(string);
    callback remove-drive(string);
    // Drive name, empty for every drive.
    callback verify(string);
    callback cancel-verify(string);
    callback show-report(string);
    // Ask for confirmation, then rebuild the drive's database (drive name).
    callback resync(string);
    // Open the folder chooser of a drive (selective sync).
    callback choose-folders(string);
    callback add-library();
    callback show-activity();
    // Conflicts and failed items of a drive (drive name).
    callback show-problems(string);
    callback show-settings();
    // Stop or resume syncing one drive (drive name, paused).
    callback pause-drive(string, bool);
    callback start-daemon();
    callback reconnect();
    callback show-window();
    callback quit();
}

component StateIcon inherits Image {
    in property <string> state;
    source: state == "idle" ? @image-url("../icons/idle.png")
        : state == "syncing" ? @image-url("../icons/syncing.png")
        : state == "paused" ? @image-url("../icons/paused.png")
        : state == "error" ? @image-url("../icons/error.png")
        : @image-url("../icons/stopped.png");
}

export global Fmt {
    // Desktop notifications, `kind` as in notify.rs: title, body and button label.
    public pure function note-title(kind: string, drive: string) -> string {
        if kind == "login" { return @tr("OneDrive: sign-in required"); }
        if kind == "error" { return @tr("{}: synchronisation error", drive); }
        if kind == "conflict" || kind == "conflicts" { return @tr("{}: file changed on both sides", drive); }
        if kind == "initial-sync" { return @tr("{} is synchronised", drive); }
        return @tr("{}: integrity check complete", drive);
    }

    public pure function note-body(kind: string, a: string, b: string, n: int) -> string {
        if kind == "login" { return @tr("The Microsoft session has expired: synchronisation is stopped until you sign in again."); }
        if kind == "error" { return a; }
        if kind == "conflict" { return @tr("{}: your local version was kept as {}.", a, b); }
        if kind == "conflicts" {
            return @tr("{n} local version was kept as a “-safeBackup-” copy." | "{n} local versions were kept as “-safeBackup-” copies." % n);
        }
        if kind == "initial-sync" { return @tr("The first synchronisation is complete."); }
        if kind == "verify-ok" { return @tr("All files are intact."); }
        return @tr("{n} file needs attention" | "{n} files need attention" % n);
    }

    public pure function note-button(kind: string) -> string {
        if kind == "login" { return @tr("Sign in again"); }
        if kind == "conflict" { return @tr("Show in folder"); }
        if kind == "initial-sync" { return @tr("Open the folder"); }
        if kind == "verify-problems" { return @tr("Details…"); }
        return "";
    }

    // Kind of a verification finding, as listed in the report.
    public pure function finding-kind(kind: string) -> string {
        if kind == "modified" { return @tr("Modified"); }
        if kind == "missing" { return @tr("Missing"); }
        return @tr("Unreadable");
    }

    public pure function state-label(state: string) -> string {
        if state == "idle" { return @tr("Up to date"); }
        if state == "syncing" { return @tr("Synchronising…"); }
        if state == "paused" { return @tr("Paused"); }
        if state == "error" { return @tr("Error"); }
        return @tr("Service not running");
    }

    public pure function last-sync-label(mins: int) -> string {
        if mins < 0 { return @tr("never"); }
        if mins < 1 { return @tr("just now"); }
        if mins < 120 { return @tr("{n} minute ago" | "{n} minutes ago" % mins); }
        return @tr("{n} hour ago" | "{n} hours ago" % floor(mins / 60));
    }

    public pure function eta-label(mins: int) -> string {
        if mins < 1 { return @tr("less than a minute left"); }
        if mins < 120 { return @tr("about {n} minute left" | "about {n} minutes left" % mins); }
        return @tr("about {n} hour left" | "about {n} hours left" % round(mins / 60));
    }

    public pure function progress-label(d: DriveRow) -> string {
        let amount = @tr("{} of {} GB ({}%)", round(d.synced-gb * 10) / 10, round(d.total-gb * 10) / 10, floor(d.fraction * 100));
        if d.rate-mbs < 0 { return amount; }
        let rate = @tr("{} MB/s", round(d.rate-mbs * 10) / 10);
        if d.eta-mins < 0 { return amount + " · " + rate; }
        return amount + " · " + rate + " · " + self.eta-label(d.eta-mins);
    }

    public pure function activity-symbol(kind: string) -> string {
        if kind == "downloaded" { return "↓"; }
        if kind == "uploaded" { return "↑"; }
        if kind == "deleted" || kind == "deleted-online" { return "✕"; }
        if kind == "conflict" { return "⚠"; }
        if kind == "initial-sync" { return "✓"; }
        return "…";
    }

    public pure function activity-title(a: ActivityRow) -> string {
        if a.kind == "initial-sync" { return @tr("First synchronisation complete"); }
        if a.kind == "more" { return @tr("and {n} other file" | "and {n} other files" % a.count); }
        return a.name;
    }

    public pure function activity-detail(a: ActivityRow) -> string {
        let what = a.kind == "downloaded" ? @tr("activity" => "Downloaded")
            : a.kind == "uploaded" ? @tr("activity" => "Uploaded")
            : a.kind == "deleted" ? @tr("Deleted here (deleted online)")
            : a.kind == "deleted-online" ? @tr("Deleted online (deleted here)")
            : a.kind == "conflict" ? @tr("Changed on both sides: local version kept as {}", a.backup)
            : "";
        let when = self.last-sync-label(a.mins);
        if what == "" { return a.drive + " · " + when; }
        return a.drive + " · " + what + " · " + when;
    }

    public pure function problems-label(d: DriveRow) -> string {
        let conflicts = @tr("{n} conflict to resolve" | "{n} conflicts to resolve" % d.conflicts);
        let failures = @tr("{n} item not synchronised" | "{n} items not synchronised" % d.failures);
        if d.conflicts > 0 && d.failures > 0 { return conflicts + " · " + failures; }
        if d.conflicts > 0 { return conflicts; }
        return failures;
    }

    public pure function upload-label(d: DriveRow) -> string {
        let files = @tr("Uploading {n} file" | "Uploading {n} files" % d.upload-files);
        let amount = @tr("{} of {} MB", round(d.upload-sent-mb), round(d.upload-total-mb));
        if d.upload-rate-mbs < 0 { return files + " · " + amount; }
        return files + " · " + amount + " · " + @tr("{} MB/s", round(d.upload-rate-mbs * 10) / 10);
    }

    public pure function verify-label(d: DriveRow) -> string {
        if d.verify-state == "queued" { return @tr("Integrity check waiting"); }
        if d.verify-state == "running" {
            return @tr("Checking files: {} of {}", d.verify-done, d.verify-total);
        }
        if d.verify-state == "cancelled" { return @tr("Integrity check stopped"); }
        if d.verify-state == "failed" { return @tr("Integrity check failed: {}", d.verify-message); }
        let when = @tr("Checked {}", self.last-sync-label(d.verify-mins));
        if d.verify-problems > 0 {
            return when + " · " + @tr("{n} file needs attention" | "{n} files need attention" % d.verify-problems);
        }
        return when + " · " + @tr("all files intact");
    }

    public pure function drive-detail(d: DriveRow) -> string {
        if d.state == "syncing" {
            return @tr("Synchronising… {} items checked, {} downloaded, {} uploaded", d.items, d.downloaded, d.uploaded);
        }
        if d.state == "error" { return d.last-error; }
        if d.state == "pending" { return @tr("Waiting for its first pass"); }
        if d.state == "paused" { return @tr("Paused: not synchronised until you resume it"); }
        return @tr("Up to date, last sync {}", self.last-sync-label(d.last-sync-mins));
    }
}

// Square button showing only an icon, explained by a tooltip.
component IconButton inherits Button {
    in property <string> tooltip;
    // Monochrome icons follow the text colour (light and dark themes).
    in property <bool> colorize: true;
    colorize-icon: root.colorize;
    accessible-label: root.tooltip;
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

component DriveView inherits Rectangle {
    in property <DriveRow> drive;
    // Removal needs a second click.
    property <bool> confirm: false;
    border-radius: 6px;
    background: Palette.alternate-background;

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: drive.state == "error" ? #c62828
                    : drive.state == "syncing" ? #0f6cbd
                    : drive.state == "idle" ? #2e7d32
                    : #9e9e9e;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: drive.title; font-weight: 600; overflow: elide; }
            Text { text: drive.sync-dir; font-size: 11px; color: Palette.alternate-foreground.transparentize(30%); overflow: elide; }
            Text {
                text: Fmt.drive-detail(drive);
                color: drive.state == "error" ? #c62828 : Palette.alternate-foreground.transparentize(20%);
                wrap: word-wrap;
            }
            if drive.verify-state != "": HorizontalLayout {
                spacing: 6px;
                Text {
                    text: Fmt.verify-label(drive);
                    font-size: 11px;
                    color: drive.verify-state == "failed" || drive.verify-problems > 0 ? #e65100 : Palette.alternate-foreground.transparentize(20%);
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                if drive.verify-state == "done" && drive.verify-problems > 0: Button {
                    text: @tr("Details…");
                    clicked => { Logic.show-report(drive.name); }
                }
            }
            if drive.conflicts > 0 || drive.failures > 0: HorizontalLayout {
                spacing: 6px;
                Text {
                    text: Fmt.problems-label(drive);
                    font-size: 11px;
                    color: #e65100;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Resolve…");
                    clicked => { Logic.show-problems(drive.name); }
                }
            }
            if drive.verify-state == "running": ProgressIndicator { progress: drive.verify-fraction; height: 4px; }
            if drive.show-progress: VerticalLayout {
                spacing: 2px;
                padding-top: 4px;
                ProgressIndicator { progress: drive.fraction; height: 6px; }
                Text {
                    text: Fmt.progress-label(drive);
                    font-size: 11px;
                    color: Palette.alternate-foreground.transparentize(20%);
                    overflow: elide;
                }
            }
            if drive.show-upload: VerticalLayout {
                spacing: 2px;
                padding-top: 4px;
                ProgressIndicator { progress: drive.upload-fraction; height: 6px; }
                Text {
                    text: Fmt.upload-label(drive);
                    font-size: 11px;
                    color: Palette.alternate-foreground.transparentize(20%);
                    overflow: elide;
                }
            }
        }
        // Icons on the title line, so the card is no taller than its text.
        VerticalLayout {
            alignment: start;
            HorizontalLayout {
                spacing: 4px;
                IconButton {
                    icon: @image-url("../icons/folder-open.svg");
                    tooltip: @tr("Open the folder");
                    clicked => { Logic.open-folder(drive.sync-dir); }
                }
                if drive.verify-state == "queued" || drive.verify-state == "running": IconButton {
                    icon: @image-url("../icons/stop.svg");
                    tooltip: @tr("Stop the integrity check");
                    clicked => { Logic.cancel-verify(drive.name); }
                }
                if drive.verify-state != "queued" && drive.verify-state != "running": IconButton {
                    icon: @image-url("../icons/verify.svg");
                    tooltip: @tr("Check that the local files are intact");
                    enabled: drive.state != "pending";
                    clicked => { Logic.verify(drive.name); }
                }
                IconButton {
                    icon: drive.state == "paused" ? @image-url("../icons/play.svg") : @image-url("../icons/pause.svg");
                    tooltip: drive.state == "paused" ? @tr("Resume syncing this drive") : @tr("Pause this drive only");
                    clicked => { Logic.pause-drive(drive.name, drive.state != "paused"); }
                }
                IconButton {
                    icon: @image-url("../icons/choose-folders.svg");
                    tooltip: @tr("Choose the folders to synchronise");
                    clicked => { Logic.choose-folders(drive.name); }
                }
                IconButton {
                    icon: @image-url("../icons/resync.svg");
                    tooltip: @tr("Resynchronise: rebuild the state of this drive from OneDrive");
                    clicked => { Logic.resync(drive.name); }
                }
                if drive.removable: IconButton {
                    icon: root.confirm ? @image-url("../icons/disconnect-confirm.svg") : @image-url("../icons/disconnect.svg");
                    colorize: !root.confirm;
                    tooltip: root.confirm ? @tr("Click again to stop syncing this library (local files are kept)") : @tr("Stop syncing this library");
                    clicked => {
                        if root.confirm {
                            Logic.remove-drive(drive.name);
                        } else {
                            root.confirm = true;
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <Status> status;
    in property <[DriveRow]> drives;
    title: "OneDrive";
    icon: @image-url("../icons/app.png");
    preferred-width: 660px;
    min-width: 420px;
    min-height: 440px;

    VerticalBox {
        HorizontalBox {
            padding: 0;
            StateIcon { state: status.state; width: 48px; height: 48px; }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: Fmt.state-label(status.state); font-size: 18px; font-weight: 600; }
                    if status.state == "syncing": Spinner { indeterminate: true; width: 18px; height: 18px; }
                }
                Text { text: status.account; color: Palette.foreground.transparentize(40%); overflow: elide; }
            }
        }

        if status.state == "stopped": Text {
            text: @tr("The onedrive-rs background service is not running. Start it to keep your files in sync.");
            wrap: word-wrap;
        }

        if status.state != "stopped": ListView {
            vertical-stretch: 1;
            for d in root.drives: VerticalLayout {
                padding-bottom: 6px;
                DriveView { drive: d; }
            }
        }

        if status.state == "stopped": Rectangle { vertical-stretch: 1; }

        if status.last-error != "": Text {
            text: status.last-error;
            color: #c62828;
            wrap: word-wrap;
        }

        HorizontalBox {
            padding: 0;
            if status.state != "stopped": Button {
                text: @tr("Add a library…");
                clicked => { Logic.add-library(); }
            }
            Button {
                text: @tr("Activity");
                clicked => { Logic.show-activity(); }
            }
            if status.state != "stopped": Button {
                text: @tr("Settings");
                clicked => { Logic.show-settings(); }
            }
            Rectangle { horizontal-stretch: 1; }
            if status.needs-login: Button {
                text: @tr("Sign in again");
                primary: true;
                clicked => { Logic.reconnect(); }
            }
            if status.state == "stopped": Button {
                text: @tr("Start service");
                primary: true;
                clicked => { Logic.start-daemon(); }
            }
            if status.state != "stopped": Button {
                text: @tr("Sync now");
                enabled: status.state == "idle" || status.state == "error";
                clicked => { Logic.sync-now(); }
            }
            if status.state != "stopped": Button {
                text: status.state == "paused" ? @tr("Resume") : @tr("Pause");
                clicked => { Logic.toggle-pause(); }
            }
        }
    }
}

// Pick a SharePoint site, then one of its document libraries, then where to sync it.
export component AddLibraryWindow inherits Window {
    in property <[StandardListViewItem]> sites;
    in property <[StandardListViewItem]> libraries;
    // Ids matching the lists above, used by Rust.
    in property <[string]> site-ids;
    in property <[string]> library-ids;
    in-out property <string> query;
    in-out property <string> name;
    in-out property <string> folder;
    in-out property <int> site-index: -1;
    in-out property <int> library-index: -1;
    in property <string> message;
    in property <bool> message-is-error;
    in property <bool> no-results;
    in property <bool> busy;
    callback search(string);
    callback site-selected(int);
    callback library-selected(int);
    callback add(string, string);
    callback cancel();

    title: @tr("Add a SharePoint library");
    icon: @image-url("../icons/app.png");
    preferred-width: 560px;
    min-width: 420px;
    min-height: 520px;

    VerticalBox {
        Text { text: @tr("1. Find the SharePoint site"); font-weight: 600; }
        HorizontalBox {
            padding: 0;
            LineEdit {
                text <=> root.query;
                placeholder-text: @tr("Site name (leave empty for all sites)");
                horizontal-stretch: 1;
                accepted => { root.search(root.query); }
            }
            Button {
                text: @tr("Search");
                clicked => { root.search(root.query); }
            }
        }
        StandardListView {
            model: root.sites;
            current-item <=> root.site-index;
            current-item-changed(i) => { root.site-selected(i); }
            min-height: 120px;
            vertical-stretch: 2;
        }

        Text { text: @tr("2. Choose the library"); font-weight: 600; }
        StandardListView {
            model: root.libraries;
            current-item <=> root.library-index;
            current-item-changed(i) => { root.library-selected(i); }
            min-height: 70px;
            vertical-stretch: 1;
        }

        Text { text: @tr("3. Name and local folder"); font-weight: 600; }
        GridLayout {
            spacing: 8px;
            Row {
                Text { text: @tr("Name"); vertical-alignment: center; }
                LineEdit { text <=> root.name; }
            }
            Row {
                Text { text: @tr("Folder"); vertical-alignment: center; }
                LineEdit { text <=> root.folder; }
            }
        }

        HorizontalBox {
            padding: 0;
            if root.busy: Spinner { indeterminate: true; width: 18px; height: 18px; }
            Text {
                text: root.no-results ? @tr("No site found") : root.message;
                color: root.message-is-error ? #c62828 : Palette.foreground;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                text: @tr("Cancel");
                clicked => { root.cancel(); }
            }
            Button {
                text: @tr("Add");
                primary: true;
                enabled: root.library-index >= 0 && root.name != "" && root.folder != "" && !root.busy;
                clicked => { root.add(root.name, root.folder); }
            }
        }
    }
}

// Files that need attention after an integrity check of one drive.
export component ReportWindow inherits Window {
    // Drive name for commands, and its displayed title.
    in property <string> drive-name;
    in property <string> drive-title;
    // Shown as "Kind — path".
    in property <[StandardListViewItem]> items;
    // Absolute paths matching `items`, used by Rust.
    in property <[string]> paths;
    in property <bool> busy;
    in-out property <int> current: -1;
    callback show-item(int);
    callback check-again();
    callback dismiss();

    title: @tr("Integrity check — {}", root.drive-title);
    icon: @image-url("../icons/app.png");
    preferred-width: 640px;
    min-width: 420px;
    min-height: 360px;

    VerticalBox {
        Text {
            text: @tr("These files differ from what was last synchronised. A modified file may simply be a local change not uploaded yet; a missing file may have been deleted on purpose. Nothing was changed on disk or online.");
            wrap: word-wrap;
        }
        StandardListView {
            model: root.items;
            current-item <=> root.current;
            vertical-stretch: 1;
        }
        HorizontalBox {
            padding: 0;
            if root.busy: Spinner { indeterminate: true; width: 18px; height: 18px; }
            Button {
                text: @tr("Show in folder");
                enabled: root.current >= 0;
                clicked => { root.show-item(root.current); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Check again");
                clicked => { root.check-again(); }
            }
            Button {
                text: @tr("Close");
                primary: true;
                clicked => { root.dismiss(); }
            }
        }
    }
}

// Confirmation before a resync, which cannot be undone.
export component ResyncWindow inherits Window {
    in property <string> drive-name;
    in property <string> drive-title;
    callback confirm();
    callback cancel();

    title: @tr("Resynchronise {}", root.drive-title);
    icon: @image-url("../icons/app.png");
    preferred-width: 520px;
    min-width: 400px;
    // Wrapped text is measured on one line: without this the buttons end up below the window.
    min-height: 360px;

    VerticalBox {
        Text {
            text: @tr("Resynchronise “{}”?", root.drive-title);
            font-size: 16px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: @tr("What onedrive-rs knows about this drive is forgotten and rebuilt from OneDrive, as after a first synchronisation:");
            wrap: word-wrap;
        }
        Text {
            text: @tr("• local files identical to the online ones are kept and not downloaded again;\n• differing local files are kept as “-safeBackup-” copies, then the online version is downloaded;\n• files deleted on one side only since the last sync come back;\n• local files that are not online are uploaded.");
            wrap: word-wrap;
        }
        Text {
            text: @tr("Every local file is read again, which takes a while for a large library. Use it when the drive looks out of sync.");
            wrap: word-wrap;
            color: Palette.foreground.transparentize(30%);
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalBox {
            padding: 0;
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Cancel");
                clicked => { root.cancel(); }
            }
            Button {
                text: @tr("Resynchronise");
                primary: true;
                clicked => { root.confirm(); }
            }
        }
    }
}

// Three-state box of the folder chooser.
component FolderCheck inherits Rectangle {
    in property <int> check;
    callback clicked();
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.check == 0 ? Palette.border : Palette.accent-background;
    background: root.check == 0 ? Palette.control-background : Palette.accent-background;
    if root.check != 0: Text {
        text: root.check == 1 ? "✓" : "–";
        color: Palette.accent-foreground;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Selective sync: which folders of a drive are synchronised on this computer.
export component FoldersWindow inherits Window {
    in property <string> drive-name;
    in property <string> drive-title;
    in property <[FolderRow]> rows;
    // The top level is being listed.
    in property <bool> loading;
    in property <bool> saving;
    // No folder would be synchronised: saving is not possible.
    in property <bool> nothing-selected;
    // Rules of the sync_list file the chooser cannot show, kept as written.
    in property <int> custom-rules;
    in property <string> message;
    in-out property <bool> delete-local;
    callback toggle(int);
    callback expand(int);
    callback save();
    callback cancel();

    title: @tr("Choose folders — {}", root.drive-title);
    icon: @image-url("../icons/app.png");
    preferred-width: 520px;
    preferred-height: 600px;
    min-width: 420px;
    min-height: 480px;

    VerticalBox {
        Text {
            text: @tr("Choose the folders of “{}” to synchronise on this computer.", root.drive-title);
            wrap: word-wrap;
        }
        Rectangle {
            vertical-stretch: 1;
            border-width: 1px;
            border-radius: 4px;
            border-color: Palette.border;
            ListView {
                for row[i] in root.rows: HorizontalLayout {
                    height: 28px;
                    padding-left: 6px + row.depth * 20px;
                    padding-right: 6px;
                    spacing: 6px;
                    Rectangle {
                        width: 16px;
                        if row.has-children: Text {
                            text: row.loading ? "…" : row.expanded ? "▾" : "▸";
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        if row.has-children: TouchArea { clicked => { root.expand(i); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        FolderCheck {
                            check: row.check;
                            clicked => { root.toggle(i); }
                        }
                    }
                    Text {
                        text: row.name;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        TouchArea {
                            clicked => { root.toggle(i); }
                            double-clicked => { if row.has-children { root.expand(i); } }
                        }
                    }
                }
            }
            if root.loading: Spinner { indeterminate: true; width: 28px; height: 28px; }
        }
        Text {
            text: @tr("Files directly at the top of the drive are always synchronised. A folder no longer synchronised keeps its local copy, unless you tick the box below; files changed locally are kept in any case.");
            wrap: word-wrap;
            font-size: 11px;
            color: Palette.foreground.transparentize(30%);
        }
        if root.custom-rules > 0: Text {
            text: @tr("{n} rule written by hand in the sync_list file is kept as is." | "{n} rules written by hand in the sync_list file are kept as they are." % root.custom-rules);
            wrap: word-wrap;
            font-size: 11px;
            color: Palette.foreground.transparentize(30%);
        }
        CheckBox {
            text: @tr("Also delete the local copy of removed folders");
            checked <=> root.delete-local;
        }
        if root.message != "": Text {
            text: root.message;
            color: #c62828;
            wrap: word-wrap;
        }
        HorizontalBox {
            padding: 0;
            if root.saving: Spinner { indeterminate: true; width: 18px; height: 18px; }
            if root.nothing-selected && !root.loading: Text {
                text: @tr("Select at least one folder.");
                vertical-alignment: center;
                color: #e65100;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Cancel");
                clicked => { root.cancel(); }
            }
            Button {
                text: @tr("Save");
                primary: true;
                enabled: !root.loading && !root.saving && !root.nothing-selected;
                clicked => { root.save(); }
            }
        }
    }
}

// Conflicts (files changed on both sides) and items that failed, of one drive.
export component ProblemsWindow inherits Window {
    in property <string> drive-name;
    in property <string> drive-title;
    in property <[ProblemRow]> rows;
    in property <bool> busy;
    in property <string> message;
    in-out property <int> current: -1;
    // Conflict: keep the local version (true) or the online one.
    callback keep(int, bool);
    callback show-item(int);
    callback retry();
    callback dismiss();

    title: @tr("To resolve — {}", root.drive-title);
    icon: @image-url("../icons/app.png");
    preferred-width: 640px;
    preferred-height: 520px;
    min-width: 460px;
    min-height: 420px;

    VerticalBox {
        Text {
            text: @tr("A conflict is a file changed both here and online: the online version is in its place, yours was kept next to it. Choose the one to keep; the other goes to the trash (and to the OneDrive recycle bin).");
            wrap: word-wrap;
        }
        Rectangle {
            vertical-stretch: 1;
            border-width: 1px;
            border-radius: 4px;
            border-color: Palette.border;
            ListView {
                for row[i] in root.rows: Rectangle {
                    height: 44px;
                    background: i == root.current ? Palette.selection-background : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 10px;
                        Text {
                            text: row.kind == "conflict" ? "⚠" : "✕";
                            width: 18px;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: row.kind == "conflict" ? #e65100 : #c62828;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: row.name;
                                overflow: elide;
                                color: i == root.current ? Palette.selection-foreground : Palette.foreground;
                            }
                            Text {
                                text: row.kind == "conflict" ? @tr("Your version: {}", row.detail) : row.detail;
                                font-size: 11px;
                                overflow: elide;
                                color: (i == root.current ? Palette.selection-foreground : Palette.foreground).transparentize(30%);
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.current = i; }
                        double-clicked => { root.current = i; root.show-item(i); }
                    }
                }
            }
            if root.rows.length == 0: Text {
                text: @tr("Nothing to resolve.");
                color: Palette.foreground.transparentize(40%);
            }
        }
        if root.message != "": Text {
            text: root.message;
            color: #c62828;
            wrap: word-wrap;
        }
        HorizontalBox {
            padding: 0;
            property <bool> conflict: root.current >= 0 && root.rows[root.current].kind == "conflict";
            property <bool> error: root.current >= 0 && root.rows[root.current].kind == "error";
            if root.busy: Spinner { indeterminate: true; width: 18px; height: 18px; }
            Button {
                text: @tr("Keep my version");
                enabled: conflict && !root.busy;
                clicked => { root.keep(root.current, true); }
            }
            Button {
                text: @tr("Keep the online version");
                enabled: conflict && !root.busy;
                clicked => { root.keep(root.current, false); }
            }
            Button {
                text: @tr("Show in folder");
                enabled: root.current >= 0;
                clicked => { root.show-item(root.current); }
            }
            if error: Button {
                text: @tr("Retry");
                clicked => { root.retry(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Close");
                primary: true;
                clicked => { root.dismiss(); }
            }
        }
    }
}

// Daemon-wide settings, and the desktop session start.
export component SettingsWindow inherits Window {
    in-out property <int> interval-mins: 5;
    in-out property <string> skip-file;
    in-out property <string> skip-dir;
    in-out property <bool> skip-dotfiles;
    in-out property <bool> autostart;
    in property <bool> busy;
    in property <string> message;
    callback save();
    callback cancel();

    title: @tr("Settings");
    icon: @image-url("../icons/app.png");
    preferred-width: 560px;
    min-width: 440px;
    // Wrapped text is measured on one line: keep the buttons in the window.
    min-height: 520px;

    VerticalBox {
        Text { text: @tr("Synchronisation"); font-weight: 600; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: @tr("Check every drive every"); vertical-alignment: center; }
            SpinBox {
                minimum: 1;
                maximum: 1440;
                value <=> root.interval-mins;
                width: 110px;
            }
            Text { text: @tr("minutes"); vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: @tr("Changes are picked up as they happen, locally and online: this full check only catches what was missed.");
            wrap: word-wrap;
            font-size: 11px;
            color: Palette.foreground.transparentize(30%);
        }
        Text { text: @tr("Not synchronised"); font-weight: 600; }
        Text { text: @tr("Files (patterns separated by |, e.g. *.bak|*.iso)"); }
        LineEdit { text <=> root.skip-file; placeholder-text: "*.bak|*.iso"; }
        Text {
            text: @tr("Always ignored as well: ~*, .~*, *.tmp, *.swp, *.partial");
            font-size: 11px;
            color: Palette.foreground.transparentize(30%);
        }
        Text { text: @tr("Folders (a name anywhere, or a path such as Documents/Old)"); }
        LineEdit { text <=> root.skip-dir; placeholder-text: "node_modules|.cache"; }
        CheckBox { text: @tr("Hidden files and folders (names starting with a dot)"); checked <=> root.skip-dotfiles; }
        Text {
            text: @tr("Items no longer synchronised keep their local copy; newly included ones are downloaded.");
            wrap: word-wrap;
            font-size: 11px;
            color: Palette.foreground.transparentize(30%);
        }
        Text { text: @tr("Desktop"); font-weight: 600; }
        CheckBox { text: @tr("Show the OneDrive icon when the session starts"); checked <=> root.autostart; }
        if root.message != "": Text {
            text: root.message;
            color: #c62828;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalBox {
            padding: 0;
            if root.busy: Spinner { indeterminate: true; width: 18px; height: 18px; }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Cancel");
                clicked => { root.cancel(); }
            }
            Button {
                text: @tr("Save");
                primary: true;
                enabled: !root.busy;
                clicked => { root.save(); }
            }
        }
    }
}

// What the daemon did recently: files received, sent, deleted, conflicts.
export component ActivityWindow inherits Window {
    in property <[ActivityRow]> rows;
    in-out property <int> current: -1;
    callback show-item(int);
    callback dismiss();

    title: @tr("Recent activity");
    icon: @image-url("../icons/app.png");
    preferred-width: 560px;
    preferred-height: 520px;
    min-width: 400px;
    min-height: 360px;

    VerticalBox {
        Rectangle {
            vertical-stretch: 1;
            border-width: 1px;
            border-radius: 4px;
            border-color: Palette.border;
            ListView {
                for row[i] in root.rows: Rectangle {
                    height: 44px;
                    background: i == root.current ? Palette.selection-background : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 10px;
                        Text {
                            text: Fmt.activity-symbol(row.kind);
                            width: 18px;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: row.kind == "conflict" ? #e65100
                                : row.kind == "deleted" || row.kind == "deleted-online" ? #c62828
                                : i == root.current ? Palette.selection-foreground : Palette.foreground;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: Fmt.activity-title(row);
                                overflow: elide;
                                color: i == root.current ? Palette.selection-foreground : Palette.foreground;
                            }
                            Text {
                                text: Fmt.activity-detail(row);
                                font-size: 11px;
                                overflow: elide;
                                color: (i == root.current ? Palette.selection-foreground : Palette.foreground).transparentize(30%);
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.current = i; }
                        double-clicked => { root.current = i; root.show-item(i); }
                    }
                }
            }
            if root.rows.length == 0: Text {
                text: @tr("Nothing synchronised recently.");
                color: Palette.foreground.transparentize(40%);
            }
        }
        HorizontalBox {
            padding: 0;
            Button {
                text: @tr("Show in folder");
                enabled: root.current >= 0 && root.rows[root.current].path != "";
                clicked => { root.show-item(root.current); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Close");
                primary: true;
                clicked => { root.dismiss(); }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    in property <Status> status;
    icon: status.state == "idle" ? @image-url("../icons/idle.png")
        : status.state == "syncing" ? @image-url("../icons/syncing.png")
        : status.state == "paused" ? @image-url("../icons/paused.png")
        : status.state == "error" ? @image-url("../icons/error.png")
        : @image-url("../icons/stopped.png");
    title: "OneDrive";
    tooltip: "OneDrive — " + Fmt.state-label(status.state);
    clicked => { Logic.show-window(); }

    Menu {
        MenuItem { title: Fmt.state-label(status.state); enabled: false; }
        MenuItem { title: @tr("Show window"); activated => { Logic.show-window(); } }
        MenuItem { title: @tr("Recent activity"); activated => { Logic.show-activity(); } }
        MenuItem { title: @tr("Settings"); enabled: status.state != "stopped"; activated => { Logic.show-settings(); } }
        if status.needs-login: MenuItem { title: @tr("Sign in again"); activated => { Logic.reconnect(); } }
        MenuSeparator { }
        MenuItem {
            title: @tr("Sync now");
            enabled: status.state == "idle" || status.state == "error";
            activated => { Logic.sync-now(); }
        }
        MenuItem {
            title: status.state == "paused" ? @tr("Resume") : @tr("Pause");
            enabled: status.state != "stopped";
            activated => { Logic.toggle-pause(); }
        }
        MenuItem { title: @tr("Open folder"); enabled: status.sync-dir != ""; activated => { Logic.open-folder(status.sync-dir); } }
        MenuItem {
            title: @tr("Check all files");
            enabled: status.state != "stopped";
            activated => { Logic.verify(""); }
        }
        MenuSeparator { }
        MenuItem { title: @tr("Quit"); activated => { Logic.quit(); } }
    }
}
