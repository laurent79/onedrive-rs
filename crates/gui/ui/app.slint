import { Button, LineEdit, ListView, ProgressIndicator, Spinner, StandardListView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

// Daemon-wide state, pushed from Rust once per second.
export struct Status {
    // "idle" | "syncing" | "paused" | "error" | "stopped" (daemon not running)
    state: string,
    account: string,
    // Folder of the account's own OneDrive.
    sync-dir: string,
    last-error: string,
    // The stored login expired: offer to sign in again.
    needs-login: bool,
}

// One synchronised drive (the account's OneDrive or a SharePoint library).
export struct DriveRow {
    // Identifier for commands: "main" or the [drive] name.
    name: string,
    // Shown to the user.
    title: string,
    sync-dir: string,
    // "idle" | "syncing" | "error" | "pending"
    state: string,
    last-error: string,
    // Minutes since its last successful pass, -1 if never.
    last-sync-mins: int,
    items: int,
    downloaded: int,
    uploaded: int,
    removable: bool,
    // Overall progress while syncing a drive that is not complete yet.
    show-progress: bool,
    // 0..1
    fraction: float,
    synced-gb: float,
    total-gb: float,
    // Download rate over the last seconds, -1 if unknown.
    rate-mbs: float,
    // Estimated minutes left, -1 if unknown.
    eta-mins: int,
    // Integrity check: "" (never) | "queued" | "running" | "done" | "cancelled" | "failed"
    verify-state: string,
    verify-done: int,
    verify-total: int,
    // 0..1
    verify-fraction: float,
    // Files missing, modified or unreadable.
    verify-problems: int,
    // Minutes since it ended, -1 if unknown.
    verify-mins: int,
    verify-message: string,
}

export global Logic {
    callback sync-now();
    callback toggle-pause();
    callback open-folder(string);
    callback remove-drive(string);
    // Drive name, empty for every drive.
    callback verify(string);
    callback cancel-verify(string);
    callback show-report(string);
    // Ask for confirmation, then rebuild the drive's database (drive name).
    callback resync(string);
    callback add-library();
    callback start-daemon();
    callback reconnect();
    callback show-window();
    callback quit();
}

component StateIcon inherits Image {
    in property <string> state;
    source: state == "idle" ? @image-url("../icons/idle.png")
        : state == "syncing" ? @image-url("../icons/syncing.png")
        : state == "paused" ? @image-url("../icons/paused.png")
        : state == "error" ? @image-url("../icons/error.png")
        : @image-url("../icons/stopped.png");
}

export global Fmt {
    // Desktop notifications, `kind` as in notify.rs: title, body and button label.
    public pure function note-title(kind: string, drive: string) -> string {
        if kind == "login" { return @tr("OneDrive: sign-in required"); }
        if kind == "error" { return @tr("{}: synchronisation error", drive); }
        if kind == "conflict" || kind == "conflicts" { return @tr("{}: file changed on both sides", drive); }
        if kind == "initial-sync" { return @tr("{} is synchronised", drive); }
        return @tr("{}: integrity check complete", drive);
    }

    public pure function note-body(kind: string, a: string, b: string, n: int) -> string {
        if kind == "login" { return @tr("The Microsoft session has expired: synchronisation is stopped until you sign in again."); }
        if kind == "error" { return a; }
        if kind == "conflict" { return @tr("{}: your local version was kept as {}.", a, b); }
        if kind == "conflicts" {
            return @tr("{n} local version was kept as a “-safeBackup-” copy." | "{n} local versions were kept as “-safeBackup-” copies." % n);
        }
        if kind == "initial-sync" { return @tr("The first synchronisation is complete."); }
        if kind == "verify-ok" { return @tr("All files are intact."); }
        return @tr("{n} file needs attention" | "{n} files need attention" % n);
    }

    public pure function note-button(kind: string) -> string {
        if kind == "login" { return @tr("Sign in again"); }
        if kind == "conflict" { return @tr("Show in folder"); }
        if kind == "initial-sync" { return @tr("Open the folder"); }
        if kind == "verify-problems" { return @tr("Details…"); }
        return "";
    }

    // Kind of a verification finding, as listed in the report.
    public pure function finding-kind(kind: string) -> string {
        if kind == "modified" { return @tr("Modified"); }
        if kind == "missing" { return @tr("Missing"); }
        return @tr("Unreadable");
    }

    public pure function state-label(state: string) -> string {
        if state == "idle" { return @tr("Up to date"); }
        if state == "syncing" { return @tr("Synchronising…"); }
        if state == "paused" { return @tr("Paused"); }
        if state == "error" { return @tr("Error"); }
        return @tr("Service not running");
    }

    public pure function last-sync-label(mins: int) -> string {
        if mins < 0 { return @tr("never"); }
        if mins < 1 { return @tr("just now"); }
        if mins < 120 { return @tr("{n} minute ago" | "{n} minutes ago" % mins); }
        return @tr("{n} hour ago" | "{n} hours ago" % floor(mins / 60));
    }

    public pure function eta-label(mins: int) -> string {
        if mins < 1 { return @tr("less than a minute left"); }
        if mins < 120 { return @tr("about {n} minute left" | "about {n} minutes left" % mins); }
        return @tr("about {n} hour left" | "about {n} hours left" % round(mins / 60));
    }

    public pure function progress-label(d: DriveRow) -> string {
        let amount = @tr("{} of {} GB ({}%)", round(d.synced-gb * 10) / 10, round(d.total-gb * 10) / 10, floor(d.fraction * 100));
        if d.rate-mbs < 0 { return amount; }
        let rate = @tr("{} MB/s", round(d.rate-mbs * 10) / 10);
        if d.eta-mins < 0 { return amount + " · " + rate; }
        return amount + " · " + rate + " · " + self.eta-label(d.eta-mins);
    }

    public pure function verify-label(d: DriveRow) -> string {
        if d.verify-state == "queued" { return @tr("Integrity check waiting"); }
        if d.verify-state == "running" {
            return @tr("Checking files: {} of {}", d.verify-done, d.verify-total);
        }
        if d.verify-state == "cancelled" { return @tr("Integrity check stopped"); }
        if d.verify-state == "failed" { return @tr("Integrity check failed: {}", d.verify-message); }
        let when = @tr("Checked {}", self.last-sync-label(d.verify-mins));
        if d.verify-problems > 0 {
            return when + " · " + @tr("{n} file needs attention" | "{n} files need attention" % d.verify-problems);
        }
        return when + " · " + @tr("all files intact");
    }

    public pure function drive-detail(d: DriveRow) -> string {
        if d.state == "syncing" {
            return @tr("Synchronising… {} items checked, {} downloaded, {} uploaded", d.items, d.downloaded, d.uploaded);
        }
        if d.state == "error" { return d.last-error; }
        if d.state == "pending" { return @tr("Waiting for its first pass"); }
        return @tr("Up to date, last sync {}", self.last-sync-label(d.last-sync-mins));
    }
}

// Square button showing only an icon, explained by a tooltip.
component IconButton inherits Button {
    in property <string> tooltip;
    // Monochrome icons follow the text colour (light and dark themes).
    in property <bool> colorize: true;
    colorize-icon: root.colorize;
    accessible-label: root.tooltip;
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

component DriveView inherits Rectangle {
    in property <DriveRow> drive;
    // Removal needs a second click.
    property <bool> confirm: false;
    border-radius: 6px;
    background: Palette.alternate-background;

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: drive.state == "error" ? #c62828
                    : drive.state == "syncing" ? #0f6cbd
                    : drive.state == "idle" ? #2e7d32
                    : #9e9e9e;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: drive.title; font-weight: 600; overflow: elide; }
            Text { text: drive.sync-dir; font-size: 11px; color: Palette.alternate-foreground.transparentize(30%); overflow: elide; }
            Text {
                text: Fmt.drive-detail(drive);
                color: drive.state == "error" ? #c62828 : Palette.alternate-foreground.transparentize(20%);
                wrap: word-wrap;
            }
            if drive.verify-state != "": HorizontalLayout {
                spacing: 6px;
                Text {
                    text: Fmt.verify-label(drive);
                    font-size: 11px;
                    color: drive.verify-state == "failed" || drive.verify-problems > 0 ? #e65100 : Palette.alternate-foreground.transparentize(20%);
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                if drive.verify-state == "done" && drive.verify-problems > 0: Button {
                    text: @tr("Details…");
                    clicked => { Logic.show-report(drive.name); }
                }
            }
            if drive.verify-state == "running": ProgressIndicator { progress: drive.verify-fraction; height: 4px; }
            if drive.show-progress: VerticalLayout {
                spacing: 2px;
                padding-top: 4px;
                ProgressIndicator { progress: drive.fraction; height: 6px; }
                Text {
                    text: Fmt.progress-label(drive);
                    font-size: 11px;
                    color: Palette.alternate-foreground.transparentize(20%);
                    overflow: elide;
                }
            }
        }
        // Icons on the title line, so the card is no taller than its text.
        VerticalLayout {
            alignment: start;
            HorizontalLayout {
                spacing: 4px;
                IconButton {
                    icon: @image-url("../icons/folder-open.svg");
                    tooltip: @tr("Open the folder");
                    clicked => { Logic.open-folder(drive.sync-dir); }
                }
                if drive.verify-state == "queued" || drive.verify-state == "running": IconButton {
                    icon: @image-url("../icons/stop.svg");
                    tooltip: @tr("Stop the integrity check");
                    clicked => { Logic.cancel-verify(drive.name); }
                }
                if drive.verify-state != "queued" && drive.verify-state != "running": IconButton {
                    icon: @image-url("../icons/verify.svg");
                    tooltip: @tr("Check that the local files are intact");
                    enabled: drive.state != "pending";
                    clicked => { Logic.verify(drive.name); }
                }
                IconButton {
                    icon: @image-url("../icons/resync.svg");
                    tooltip: @tr("Resynchronise: rebuild the state of this drive from OneDrive");
                    clicked => { Logic.resync(drive.name); }
                }
                if drive.removable: IconButton {
                    icon: root.confirm ? @image-url("../icons/disconnect-confirm.svg") : @image-url("../icons/disconnect.svg");
                    colorize: !root.confirm;
                    tooltip: root.confirm ? @tr("Click again to stop syncing this library (local files are kept)") : @tr("Stop syncing this library");
                    clicked => {
                        if root.confirm {
                            Logic.remove-drive(drive.name);
                        } else {
                            root.confirm = true;
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <Status> status;
    in property <[DriveRow]> drives;
    title: "OneDrive";
    icon: @image-url("../icons/app.png");
    preferred-width: 560px;
    min-width: 420px;
    min-height: 440px;

    VerticalBox {
        HorizontalBox {
            padding: 0;
            StateIcon { state: status.state; width: 48px; height: 48px; }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: Fmt.state-label(status.state); font-size: 18px; font-weight: 600; }
                    if status.state == "syncing": Spinner { indeterminate: true; width: 18px; height: 18px; }
                }
                Text { text: status.account; color: Palette.foreground.transparentize(40%); overflow: elide; }
            }
        }

        if status.state == "stopped": Text {
            text: @tr("The onedrive-rs background service is not running. Start it to keep your files in sync.");
            wrap: word-wrap;
        }

        if status.state != "stopped": ListView {
            vertical-stretch: 1;
            for d in root.drives: VerticalLayout {
                padding-bottom: 6px;
                DriveView { drive: d; }
            }
        }

        if status.state == "stopped": Rectangle { vertical-stretch: 1; }

        if status.last-error != "": Text {
            text: status.last-error;
            color: #c62828;
            wrap: word-wrap;
        }

        HorizontalBox {
            padding: 0;
            if status.state != "stopped": Button {
                text: @tr("Add a library…");
                clicked => { Logic.add-library(); }
            }
            Rectangle { horizontal-stretch: 1; }
            if status.needs-login: Button {
                text: @tr("Sign in again");
                primary: true;
                clicked => { Logic.reconnect(); }
            }
            if status.state == "stopped": Button {
                text: @tr("Start service");
                primary: true;
                clicked => { Logic.start-daemon(); }
            }
            if status.state != "stopped": Button {
                text: @tr("Sync now");
                enabled: status.state == "idle" || status.state == "error";
                clicked => { Logic.sync-now(); }
            }
            if status.state != "stopped": Button {
                text: status.state == "paused" ? @tr("Resume") : @tr("Pause");
                clicked => { Logic.toggle-pause(); }
            }
        }
    }
}

// Pick a SharePoint site, then one of its document libraries, then where to sync it.
export component AddLibraryWindow inherits Window {
    in property <[StandardListViewItem]> sites;
    in property <[StandardListViewItem]> libraries;
    // Ids matching the lists above, used by Rust.
    in property <[string]> site-ids;
    in property <[string]> library-ids;
    in-out property <string> query;
    in-out property <string> name;
    in-out property <string> folder;
    in-out property <int> site-index: -1;
    in-out property <int> library-index: -1;
    in property <string> message;
    in property <bool> message-is-error;
    in property <bool> no-results;
    in property <bool> busy;
    callback search(string);
    callback site-selected(int);
    callback library-selected(int);
    callback add(string, string);
    callback cancel();

    title: @tr("Add a SharePoint library");
    icon: @image-url("../icons/app.png");
    preferred-width: 560px;
    min-width: 420px;
    min-height: 520px;

    VerticalBox {
        Text { text: @tr("1. Find the SharePoint site"); font-weight: 600; }
        HorizontalBox {
            padding: 0;
            LineEdit {
                text <=> root.query;
                placeholder-text: @tr("Site name (leave empty for all sites)");
                horizontal-stretch: 1;
                accepted => { root.search(root.query); }
            }
            Button {
                text: @tr("Search");
                clicked => { root.search(root.query); }
            }
        }
        StandardListView {
            model: root.sites;
            current-item <=> root.site-index;
            current-item-changed(i) => { root.site-selected(i); }
            min-height: 120px;
            vertical-stretch: 2;
        }

        Text { text: @tr("2. Choose the library"); font-weight: 600; }
        StandardListView {
            model: root.libraries;
            current-item <=> root.library-index;
            current-item-changed(i) => { root.library-selected(i); }
            min-height: 70px;
            vertical-stretch: 1;
        }

        Text { text: @tr("3. Name and local folder"); font-weight: 600; }
        GridLayout {
            spacing: 8px;
            Row {
                Text { text: @tr("Name"); vertical-alignment: center; }
                LineEdit { text <=> root.name; }
            }
            Row {
                Text { text: @tr("Folder"); vertical-alignment: center; }
                LineEdit { text <=> root.folder; }
            }
        }

        HorizontalBox {
            padding: 0;
            if root.busy: Spinner { indeterminate: true; width: 18px; height: 18px; }
            Text {
                text: root.no-results ? @tr("No site found") : root.message;
                color: root.message-is-error ? #c62828 : Palette.foreground;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                text: @tr("Cancel");
                clicked => { root.cancel(); }
            }
            Button {
                text: @tr("Add");
                primary: true;
                enabled: root.library-index >= 0 && root.name != "" && root.folder != "" && !root.busy;
                clicked => { root.add(root.name, root.folder); }
            }
        }
    }
}

// Files that need attention after an integrity check of one drive.
export component ReportWindow inherits Window {
    // Drive name for commands, and its displayed title.
    in property <string> drive-name;
    in property <string> drive-title;
    // Shown as "Kind — path".
    in property <[StandardListViewItem]> items;
    // Absolute paths matching `items`, used by Rust.
    in property <[string]> paths;
    in property <bool> busy;
    in-out property <int> current: -1;
    callback show-item(int);
    callback check-again();
    callback dismiss();

    title: @tr("Integrity check — {}", root.drive-title);
    icon: @image-url("../icons/app.png");
    preferred-width: 640px;
    min-width: 420px;
    min-height: 360px;

    VerticalBox {
        Text {
            text: @tr("These files differ from what was last synchronised. A modified file may simply be a local change not uploaded yet; a missing file may have been deleted on purpose. Nothing was changed on disk or online.");
            wrap: word-wrap;
        }
        StandardListView {
            model: root.items;
            current-item <=> root.current;
            vertical-stretch: 1;
        }
        HorizontalBox {
            padding: 0;
            if root.busy: Spinner { indeterminate: true; width: 18px; height: 18px; }
            Button {
                text: @tr("Show in folder");
                enabled: root.current >= 0;
                clicked => { root.show-item(root.current); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Check again");
                clicked => { root.check-again(); }
            }
            Button {
                text: @tr("Close");
                primary: true;
                clicked => { root.dismiss(); }
            }
        }
    }
}

// Confirmation before a resync, which cannot be undone.
export component ResyncWindow inherits Window {
    in property <string> drive-name;
    in property <string> drive-title;
    callback confirm();
    callback cancel();

    title: @tr("Resynchronise {}", root.drive-title);
    icon: @image-url("../icons/app.png");
    preferred-width: 520px;
    min-width: 400px;
    // Wrapped text is measured on one line: without this the buttons end up below the window.
    min-height: 360px;

    VerticalBox {
        Text {
            text: @tr("Resynchronise “{}”?", root.drive-title);
            font-size: 16px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: @tr("What onedrive-rs knows about this drive is forgotten and rebuilt from OneDrive, as after a first synchronisation:");
            wrap: word-wrap;
        }
        Text {
            text: @tr("• local files identical to the online ones are kept and not downloaded again;\n• differing local files are kept as “-safeBackup-” copies, then the online version is downloaded;\n• files deleted on one side only since the last sync come back;\n• local files that are not online are uploaded.");
            wrap: word-wrap;
        }
        Text {
            text: @tr("Every local file is read again, which takes a while for a large library. Use it when the drive looks out of sync.");
            wrap: word-wrap;
            color: Palette.foreground.transparentize(30%);
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalBox {
            padding: 0;
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Cancel");
                clicked => { root.cancel(); }
            }
            Button {
                text: @tr("Resynchronise");
                primary: true;
                clicked => { root.confirm(); }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    in property <Status> status;
    icon: status.state == "idle" ? @image-url("../icons/idle.png")
        : status.state == "syncing" ? @image-url("../icons/syncing.png")
        : status.state == "paused" ? @image-url("../icons/paused.png")
        : status.state == "error" ? @image-url("../icons/error.png")
        : @image-url("../icons/stopped.png");
    title: "OneDrive";
    tooltip: "OneDrive — " + Fmt.state-label(status.state);
    clicked => { Logic.show-window(); }

    Menu {
        MenuItem { title: Fmt.state-label(status.state); enabled: false; }
        MenuItem { title: @tr("Show window"); activated => { Logic.show-window(); } }
        if status.needs-login: MenuItem { title: @tr("Sign in again"); activated => { Logic.reconnect(); } }
        MenuSeparator { }
        MenuItem {
            title: @tr("Sync now");
            enabled: status.state == "idle" || status.state == "error";
            activated => { Logic.sync-now(); }
        }
        MenuItem {
            title: status.state == "paused" ? @tr("Resume") : @tr("Pause");
            enabled: status.state != "stopped";
            activated => { Logic.toggle-pause(); }
        }
        MenuItem { title: @tr("Open folder"); enabled: status.sync-dir != ""; activated => { Logic.open-folder(status.sync-dir); } }
        MenuItem {
            title: @tr("Check all files");
            enabled: status.state != "stopped";
            activated => { Logic.verify(""); }
        }
        MenuSeparator { }
        MenuItem { title: @tr("Quit"); activated => { Logic.quit(); } }
    }
}
