# User service for onedrive-rs, installed by contrib/install.sh.
#   systemctl --user enable --now onedrive-rs
[Unit]
Description=OneDrive client (onedrive-rs)

[Service]
Type=dbus
BusName=io.github.onedrive_rs.OneDrive1
ExecStart=%h/.local/bin/onedrive-rs daemon
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
